# Copy to .env (chmod 600) and fill in. Never commit .env.

# Token of the NEW bot made with @BotFather for this project (not the YouTube bot's token).
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (get it from @userinfobot). Several: comma-separated.
TELEGRAM_ALLOWED_USER_IDS=

# Dashboard login password (http://localhost:8090). Pick any long password.
DASHBOARD_PASSWORD=

# Meta app (developers.facebook.com → My Apps → your app → App settings → Basic).
META_APP_ID=
META_APP_SECRET=

# Buffer (publish.buffer.com -> Settings -> API -> create a personal API key). Drafts, statistics, story drafts.
BUFFER_API_KEY=
# Free stock footage keys (optional; Wikimedia Commons works without a key).
PEXELS_API_KEY=
PIXABAY_API_KEY=
